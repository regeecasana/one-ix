// Matches docs/data-model.md -- the XLSmart/Ravta telco story.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Neon free tier, both locally and hosted -- see docs/hosting.md
  url      = env("DATABASE_URL")
}

model Customer {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  mobileNumber  String?  @unique
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())

  carts          Cart[]
  orders         Order[]
  supportTickets SupportTicket[]
}

model Product {
  id          String @id @default(cuid())
  name        String
  description String
  priceCents  Int
  imageUrl    String
  stock       Int

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id              String    @id @default(cuid())
  customerId      String?
  status          String    @default("active") // active | abandoned | converted
  lastActivityAt  DateTime  @default(now())
  remindedAt      DateTime? // set once the CDP nudge email is sent
  utmSource       String?
  utmCampaign     String?
  utmContent      String?
  recommendationReason String?
  pendingOtpMobile String?  // set by POST .../otp/request, cleared on verify
  pendingOtpCode   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]
  order    Order?
}

model CartItem {
  id             String @id @default(cuid())
  cartId         String
  productId      String
  quantity       Int
  unitPriceCents Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String   @id @default(cuid())
  cartId        String   @unique
  customerId    String
  status        String   @default("paid")
  subtotalCents Int
  totalCents    Int
  pointsEarned  Int      @default(0)
  createdAt     DateTime @default(now())

  cart     Cart        @relation(fields: [cartId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SupportTicket {
  id              String   @id @default(cuid())
  customerId      String
  zendeskTicketId String?
  subject         String
  message         String
  createdAt       DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}
