# See docs/demo-setup.md and docs/hosting.md for details on each of these.

# Neon free Postgres connection string -- used both locally and when hosted.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/oneix?sslmode=require"

PORT=4000
STOREFRONT_URL="http://localhost:5173"

# Shared secret the Zendesk sidebar app sends as X-Internal-Token
INTERNAL_API_TOKEN="change-me"

# Zendesk API auth (Admin Center -> Apps and integrations -> APIs -> Zendesk API)
ZENDESK_SUBDOMAIN=""
ZENDESK_EMAIL=""
ZENDESK_API_TOKEN=""

# Default voucher lifespan -- matches the story's "30 minutes to 1 hour"
VOUCHER_TTL_MINUTES=30
