# MongoDB Atlas connection string -- same cluster/string works for local dev
# and production. Named MONGODB_URI (not DATABASE_URL) to match what
# Vercel's MongoDB Atlas integration auto-injects -- no manual env var
# wiring needed once that integration is added to the Vercel project.
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/oneix?retryWrites=true&w=majority"

# Used to build absolute links in outbound emails. Leave unset locally --
# defaults to http://localhost:3000. On Vercel, VERCEL_URL is set
# automatically; only set this explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=""

# Shared secret the Zendesk sidebar app sends as X-Internal-Token
INTERNAL_API_TOKEN="change-me"

# Signs the per-customer session token issued by POST /api/identify.
# Optional -- falls back to a random per-process secret if unset (sessions
# just won't survive a restart/redeploy).
SESSION_SECRET="change-me-too"

# Zendesk API auth (Admin Center -> Apps and integrations -> APIs -> Zendesk API).
# Prefixed WEB_ -- plain ZENDESK_SUBDOMAIN/EMAIL/API_TOKEN collide with the
# names zcli (apps/zendesk-ticket-sidebar-app's CLI) commonly stores as
# machine-level env vars, e.g. via `zcli login`. A machine-level env var of
# the same name always wins over anything in this file, no matter what's
# written here or how many times the dev server restarts -- if you hit that,
# `echo $ZENDESK_SUBDOMAIN` in your shell will show it. Scoping this app's
# vars to a distinct name is the actual fix; renaming this file wouldn't be,
# since OS env still outranks any .env* file regardless of filename.
WEB_ZENDESK_SUBDOMAIN=""
WEB_ZENDESK_EMAIL=""
WEB_ZENDESK_API_TOKEN=""

# Optional. Only needed on a multi-brand Zendesk account (Admin Center ->
# Account -> Brand Management) -- without it, ticket creation silently
# falls back to whichever brand the account treats as default, which may
# not be this project's brand. Find the id via GET /api/v2/brands.json.
WEB_ZENDESK_BRAND_ID=""

# Default voucher lifespan -- matches the story's "30 minutes to 1 hour"
VOUCHER_TTL_MINUTES=30

# Powers the sidebar app's on-demand "Get AI insight" button. Optional --
# without it, that endpoint returns 503 insights_not_configured and the
# button shows a graceful message instead of failing.
OPENAI_API_KEY=""
